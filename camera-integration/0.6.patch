+++ b/src/com/codex/note8camera/RemoteRecording.java
@@ -0,0 +1,22 @@
+package com.codex.note8camera;
+import android.os.SystemClock;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import org.json.JSONObject;
+/** Records a local monotonic start time only for an explicitly armed remote session. */
+final class RemoteRecording {
+    static boolean armed(){
+        try(FileInputStream in=new FileInputStream(MediaFiles.file("remote-record-request.json"))){byte[] b=new byte[4096];int n=in.read(b);if(n<1)return false;JSONObject o=new JSONObject(new String(b,0,n,StandardCharsets.UTF_8));long age=SystemClock.elapsedRealtime()-o.getLong("issuedMs");return age>=0&&age<20000&&o.optString("id").matches("[a-fA-F0-9-]{16,64}");}catch(Exception ignored){return false;}
+    }
+    static void started(){
+        File request=MediaFiles.file("remote-record-request.json");if(!request.isFile())return;
+        try(FileInputStream in=new FileInputStream(request)){
+            byte[] bytes=new byte[4096];int n=in.read(bytes);if(n<1)return;
+            JSONObject o=new JSONObject(new String(bytes,0,n,StandardCharsets.UTF_8));String id=o.getString("id");long now=SystemClock.elapsedRealtime(),age=now-o.getLong("issuedMs");
+            if(!id.matches("[a-fA-F0-9-]{16,64}")||age<0||age>20000)return;
+            File temp=MediaFiles.file("remote-record-start.json.tmp");
+            try(FileOutputStream out=new FileOutputStream(temp)){out.write(new JSONObject().put("id",id).put("startedMs",now).toString().getBytes(StandardCharsets.UTF_8));}
+            android.system.Os.rename(temp.getPath(),MediaFiles.file("remote-record-start.json").getPath());
+        }catch(Exception e){de.robv.android.xposed.XposedBridge.log("[Note8Remote] Recording start signal unavailable");}
+    }
+}
